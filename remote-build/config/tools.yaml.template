# 工具链（首次启动探测自动生成，此文件为参考模板）
# 说明：目标（targets）自 v0.4 起随项目走，定义在各工程 project.yaml 的 targets: 段，不再有全局 targets.yaml
tools:
  java:
    name: java
    tool_type: system
    command: java
    version: "17.0.2"
    version_check: "java -version"
    detected_from: JAVA_HOME
    env:
      JAVA_HOME: "C:/Program Files/Java/jdk-17.0.2"

  putty:
    # putty 条目由探测自动生成，仅供 UI 展示与版本核对；
    # 传输实际路径以套件探测为准（自定义目录 → PATH → Program Files，见 src/transport/putty.rs）
    name: putty
    tool_type: custom
    command: C:/Program Files/PuTTY/pscp.exe
    version_check: "plink -V"
    detected_from: "Program Files"
